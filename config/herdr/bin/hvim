#!/usr/bin/env bash
# One Neovim per Herdr workspace, viewed from any pane. A headless Neovim
# listens on a per-workspace socket; hvim opens files in it and then attaches
# a UI to it in the current pane. Every attached UI shows the same editor.
# Leave a view with :detach; :quit on the last window stops the editor.
# Outside Herdr this is plain nvim.
#
#   hvim [--wait] [+LINE] [FILE...]
#
# --wait closes the view and returns once the files' buffers are closed
# (hidden buffers are wiped), so `hvim --wait` works as $VISUAL for git.
set -euo pipefail

if [[ -z "${HERDR_WORKSPACE_ID:-}" ]]; then
  [[ "${1:-}" == "--wait" ]] && shift
  exec nvim "$@"
fi

wait=0
if [[ "${1:-}" == "--wait" ]]; then
  wait=1
  shift
fi

dir="${XDG_STATE_HOME:-$HOME/.local/state}/hvim"
mkdir -p "$dir"
chmod 700 "$dir"
sock="$dir/$HERDR_WORKSPACE_ID.sock"

remote_expr() {
  nvr --servername "$sock" --nostart --remote-expr "$1" 2>/dev/null
}

alive() {
  [[ -S "$sock" ]] && remote_expr 1 >/dev/null
}

if ! alive; then
  rm -f "$sock"
  # In its own session, so closing this pane does not take the editor with it.
  perl -MPOSIX=setsid -e 'setsid; exec @ARGV' nvim --headless --listen "$sock" \
    </dev/null >/dev/null 2>&1 &
  for _ in $(seq 50); do
    alive && break
    sleep 0.1
  done
  alive || { echo "hvim: editor did not start on $sock" >&2; exit 1; }
fi

if [[ $# -eq 0 ]]; then
  exec nvim --server "$sock" --remote-ui
fi

# Open the files once this view has attached: attaching can move the cursor,
# which would lose the requested line. Prints the new view's channel.
ui_chans() {
  remote_expr 'join(map(nvim_list_uis(), "v:val.chan"))' || true
}
before=" $(ui_chans) "
new_view() {
  for _ in $(seq 30); do
    for chan in $(ui_chans); do
      [[ "$before" == *" $chan "* ]] || { echo "$chan"; return; }
    done
    sleep 0.1
  done
}

if ((!wait)); then
  (
    new_view >/dev/null
    nvr --servername "$sock" --nostart -s --remote "$@"
  ) </dev/null >/dev/null 2>&1 &
  exec nvim --server "$sock" --remote-ui
fi

# Wait mode: once the files' buffers are gone, close this view's channel,
# which ends the view cleanly (as :detach would).
(
  chan="$(new_view)"
  nvr --servername "$sock" --nostart -s --remote-wait +'set bufhidden=wipe' "$@"
  [[ -n "$chan" ]] && remote_expr "chanclose($chan)" >/dev/null
) </dev/null >/dev/null 2>&1 &
watcher=$!

status=0
nvim --server "$sock" --remote-ui || status=$?
kill "$watcher" 2>/dev/null || true
exit "$status"
